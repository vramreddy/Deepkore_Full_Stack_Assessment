# ==========================
# SmartOps - Environment Variables
# ==========================
# Copy this file to .env and fill in the values

# --- Backend (backend/.env) ---
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smart-ops?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
ADMIN_CLEARANCE_KEY=DEEPKORE-ADMIN-2026

# --- Frontend (frontend/.env) ---
VITE_API_URL=http://localhost:5000/api

# --- Admin Portal (admin/.env) ---
VITE_API_URL=http://localhost:5000/api
